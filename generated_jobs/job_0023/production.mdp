; Production MD (NPT ensemble) -- mdflow base template (PROJECT-CREATED)
; Template variables: nsteps, dt_ps, temperature_K, pressure_bar, random_seed
integrator              = md
dt                      = 0.002
nsteps                  = 10000000

; continue from the NPT checkpoint (coordinates + velocities)
continuation            = yes
gen-vel                 = no
ld-seed                 = 983797624

constraints             = h-bonds
constraint-algorithm    = lincs

cutoff-scheme           = Verlet
nstlist                 = 10
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres

tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 0.1
ref-t                   = 320

pcoupl                  = C-rescale
pcoupltype              = isotropic
tau-p                   = 2.0
ref-p                   = 10
compressibility         = 4.5e-5

nstxout-compressed      = 5000
nstvout                 = 0
nstenergy               = 1000
nstlog                  = 5000
