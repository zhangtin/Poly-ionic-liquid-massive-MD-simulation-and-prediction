; Energy minimization -- mdflow base template (PROJECT-CREATED)
; Template variables: nsteps
integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 50000

cutoff-scheme           = Verlet
nstlist                 = 10
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres

nstenergy               = 100
nstlog                  = 100
