; NVT equilibration -- mdflow base template (PROJECT-CREATED)
; Template variables: nsteps, dt_ps, temperature_K, random_seed
integrator              = md
dt                      = 0.002
nsteps                  = 500000

; start from EM coordinates without velocities -> generate Maxwell velocities
continuation            = no
gen-vel                 = yes
gen-temp                = 320
gen-seed                = 1834998033
; seed for the stochastic V-rescale thermostat (reproducibility)
ld-seed                 = 1834998033

constraints             = h-bonds
constraint-algorithm    = lincs

cutoff-scheme           = Verlet
nstlist                 = 10
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres

tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 0.1
ref-t                   = 320
pcoupl                  = no

nstxout-compressed      = 5000
nstenergy               = 500
nstlog                  = 500
